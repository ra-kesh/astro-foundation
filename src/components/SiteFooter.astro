---
import site from '@/config/site';

const year = new Date().getFullYear();
---

<footer>
  <p>&copy; {year} {site.author.name}</p>
  {
    site.author.links.length > 0 && (
      <nav aria-label="Author links">
        <ul>
          {site.author.links.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</footer>
